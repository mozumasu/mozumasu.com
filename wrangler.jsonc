{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mozumasu-com",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mozumasu.com",
      "custom_domain": true
    }
  ],
  // assets-only Worker: no script, so no binding either
  "assets": {
    "directory": "./public"
  }
}
